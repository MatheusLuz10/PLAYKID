# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel → Project Settings → API / Data API).
# Sem estas variáveis o ECO QUEST roda em MODO DEMONSTRAÇÃO (dados só no navegador).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA (anon ou publishable "sb_publishable_..."). É segura no navegador
# porque todo acesso é controlado pelas políticas RLS do banco.
VITE_SUPABASE_ANON_KEY=

# NUNCA coloque aqui a service_role / secret key nem a senha do banco.
# O app recusa chaves privilegiadas e volta para o modo demonstração.
